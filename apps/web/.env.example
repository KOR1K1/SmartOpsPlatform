# Next.js Public Environment Variables
# These are exposed to the browser (prefix with NEXT_PUBLIC_)

# API URL
# For Docker: use service name (e.g., http://api:4000) or external URL
NEXT_PUBLIC_API_URL="http://localhost:4000"

# App URL (for metadata, sitemap, etc.)
# For Docker: use container name or external URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment
NODE_ENV=development

# JWT Secret (REQUIRED - must match backend JWT_SECRET)
# CRITICAL: This must be set and must match the backend JWT_SECRET
# Generate a strong secret: openssl rand -base64 32
# Never use default values or commit secrets to version control
JWT_SECRET=your-secret-key-change-in-production
