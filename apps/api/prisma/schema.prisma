generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      Role      @relation(fields: [roleId], references: [id])
  roleId    Int
  tasks     Task[]
  events    TaskEvent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([roleId])
  @@index([deletedAt]) // Index for count queries
  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("roles")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @db.Text
  status      String
  assignee    User?      @relation(fields: [assigneeId], references: [id])
  assigneeId  Int?
  events      TaskEvent[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt, status]) // Composite index for analytics queries
  @@map("tasks")
}

model TaskEvent {
  id        Int      @id @default(autoincrement())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  type      String
  message   String   @db.Text
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt, createdAt]) // Composite index for recent events queries
  @@map("task_events")
}

model SystemEvent {
  id        Int      @id @default(autoincrement())
  type      String
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([type])
  @@index([createdAt])
  @@map("system_events")
}

model KnowledgeCategory {
  id        Int                @id @default(autoincrement())
  title     String
  slug      String              @unique
  documents KnowledgeDocument[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("knowledge_categories")
}

model KnowledgeDocument {
  id          Int               @id @default(autoincrement())
  title       String
  content     String             @db.Text
  slug        String             @unique
  category    KnowledgeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  versions    DocumentVersion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([slug])
  @@index([createdAt])
  @@index([deletedAt]) // Index for count queries
  @@map("knowledge_documents")
}

model DocumentVersion {
  id          Int               @id @default(autoincrement())
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  Int
  content     String            @db.Text
  version     Int
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@unique([documentId, version])
  @@index([documentId])
  @@index([version])
  @@index([createdAt])
  @@map("document_versions")
}
