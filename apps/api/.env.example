# Database
# Format: postgresql://user:password@host:port/database?schema=public
# For Docker: use service name as host (e.g., postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/smartops?schema=public"

# Server
# Port for API server (default: 4000)
PORT=4000
NODE_ENV=development

# Frontend URL for CORS
# For Docker: use service name or container name
FRONTEND_URL="http://localhost:3000"

# JWT Authentication
# Generate strong secrets for production (e.g., openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
