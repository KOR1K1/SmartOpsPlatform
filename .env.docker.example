# Docker Environment Variables
# Copy this file to .env and update values for your environment

# Database Configuration
# For Docker: use service name 'postgres' as host
DATABASE_URL=postgresql://smartops:smartops_password@postgres:5432/smartops?schema=public

# API Configuration
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://web:3000

# JWT Authentication Secrets
# Generate strong secrets for production (e.g., openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Web Application Configuration
# For Docker: use service name 'api' or 'localhost' for external access
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
