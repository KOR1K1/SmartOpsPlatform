# Docker Environment Variables
# Copy this file to .env and update values for your environment

# Database Configuration
# For Docker: use service name 'postgres' as host and configure safe pool limits
DATABASE_URL=postgresql://smartops:smartops_password@postgres:5432/smartops?schema=public&connection_limit=10&pool_timeout=30
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_TIMEOUT_MS=5000

# API Configuration
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://web:3000

# JWT Authentication Secrets (REQUIRED)
# CRITICAL: These secrets MUST be set and MUST match between API and Web services
# Generate strong secrets for production:
#   Linux/Mac: openssl rand -base64 32
#   Windows: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Never use default values in production!
# Minimum recommended length: 32 characters
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Web Application Configuration
# For Docker: use service name 'api' or 'localhost' for external access
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
